<?xml version="1.0" encoding="utf-8"?>
<!--
  The ways out, each only after Matthew taps for it, and nothing else:
  - the one message posted to his pool on the beach (decision 18);
  - the model's one download: Hugging Face's address for the file, and the
    content servers it redirects that download to (model/ModelStore.kt, HOSTS).
  No other host is trusted, so the app can open a TLS connection to these
  alone, and plain HTTP is refused everywhere.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors />
    </base-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">beach.happyseaurchin.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">huggingface.co</domain>
        <domain includeSubdomains="false">us.aws.cdn.hf.co</domain>
        <domain includeSubdomains="false">us.gcp.cdn.hf.co</domain>
        <domain includeSubdomains="false">cas-bridge.xethub.hf.co</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
