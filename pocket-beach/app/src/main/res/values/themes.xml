<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Sundial's paper before the first frame, so the app never opens on a default white or black. -->
    <style name="Theme.PocketBeach" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/pocket_window</item>
    </style>
    <!-- Sundial's own tokens (night-watchman.css:13-21): the mark's ground is Sundial's paper. -->
    <color name="sundial_paper">#EEE7D5</color>
    <color name="pocket_window">#EEE7D5</color>
</resources>
